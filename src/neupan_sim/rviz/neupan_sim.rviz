Panels:
  - Class: rviz_common/Displays
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /Simulation1
        - /NeuPAN1
      Splitter Ratio: 0.52
    Tree Height: 680
  - Class: rviz_common/Selection
    Name: Selection
  - Class: rviz_common/Views
    Name: Views
    Expanded:
      - /Current View1
    Splitter Ratio: 0.5
Visualization Manager:
  Class: ""
  Displays:
    - Alpha: 0.35
      Cell Size: 1
      Class: rviz_default_plugins/Grid
      Color: 120; 120; 125
      Enabled: true
      Line Style:
        Line Width: 0.03
        Value: Lines
      Name: Grid
      Offset:
        X: 0
        Y: 0
        Z: 0
      Plane: XY
      Plane Cell Count: 20
      Reference Frame: <Fixed Frame>
      Value: true
    - Class: rviz_common/Group
      Displays:
        - Class: rviz_default_plugins/MarkerArray
          Enabled: true
          Name: World Robot Metrics
          Namespaces: {}
          Topic:
            Depth: 5
            Durability Policy: Transient Local
            History Policy: Keep Last
            Reliability Policy: Reliable
            Value: /neupan_sim/markers
          Value: true
        - Alpha: 1
          Autocompute Intensity Bounds: true
          Autocompute Value Bounds:
            Max Value: 10
            Min Value: -10
            Value: true
          Axis: Z
          Channel Name: intensity
          Class: rviz_default_plugins/PointCloud2
          Color Transformer: Intensity
          Decay Time: 0.1
          Enabled: true
          Invert Rainbow: false
          Max Color: 255; 80; 30
          Max Intensity: 1
          Min Color: 80; 180; 255
          Min Intensity: 0
          Name: XYZIV Obstacle Hits
          Position Transformer: XYZ
          Selectable: true
          Size (Pixels): 4
          Size (m): 0.04
          Style: Flat Squares
          Topic:
            Depth: 5
            Durability Policy: Volatile
            Filter size: 10
            History Policy: Keep Last
            Reliability Policy: Best Effort
            Value: /obstacles
          Use Fixed Frame: true
          Use rainbow: false
          Value: true
        - Alpha: 1
          Autocompute Intensity Bounds: true
          Autocompute Value Bounds:
            Max Value: 10
            Min Value: -10
            Value: true
          Axis: Z
          Channel Name: intensity
          Class: rviz_default_plugins/LaserScan
          Color: 255; 210; 60
          Color Transformer: FlatColor
          Decay Time: 0.1
          Enabled: false
          Invert Rainbow: false
          Name: LaserScan (toggle)
          Position Transformer: XYZ
          Selectable: true
          Size (Pixels): 3
          Size (m): 0.03
          Style: Flat Squares
          Topic:
            Depth: 5
            Durability Policy: Volatile
            Filter size: 10
            History Policy: Keep Last
            Reliability Policy: Best Effort
            Value: /scan
          Use Fixed Frame: true
          Use rainbow: false
          Value: false
        - Class: rviz_default_plugins/Axes
          Enabled: true
          Length: 0.5
          Name: Base Axes
          Radius: 0.035
          Reference Frame: base_link
          Value: true
      Enabled: true
      Name: Simulation
    - Class: rviz_common/Group
      Displays:
        - Alpha: 0.8
          Buffer Length: 1
          Class: rviz_default_plugins/Path
          Color: 80; 220; 80
          Enabled: true
          Line Style: Lines
          Line Width: 0.04
          Name: Initial Path
          Offset:
            X: 0
            Y: 0
            Z: 0
          Pose Style: None
          Topic:
            Depth: 5
            Durability Policy: Volatile
            Filter size: 10
            History Policy: Keep Last
            Reliability Policy: Reliable
            Value: /initial_path
          Value: true
        - Alpha: 1
          Buffer Length: 1
          Class: rviz_default_plugins/Path
          Color: 255; 70; 70
          Enabled: true
          Line Style: Billboards
          Line Width: 0.045
          Name: NeuPAN Plan
          Offset:
            X: 0
            Y: 0
            Z: 0.02
          Pose Style: None
          Topic:
            Depth: 5
            Durability Policy: Volatile
            Filter size: 10
            History Policy: Keep Last
            Reliability Policy: Reliable
            Value: /neupan_plan
          Value: true
        - Alpha: 0.8
          Buffer Length: 1
          Class: rviz_default_plugins/Path
          Color: 80; 140; 255
          Enabled: true
          Line Style: Lines
          Line Width: 0.03
          Name: Reference State
          Offset:
            X: 0
            Y: 0
            Z: 0.03
          Pose Style: None
          Topic:
            Depth: 5
            Durability Policy: Volatile
            Filter size: 10
            History Policy: Keep Last
            Reliability Policy: Reliable
            Value: /neupan_ref_state
          Value: true
        - Class: rviz_default_plugins/MarkerArray
          Enabled: false
          Name: DUNE Points (toggle)
          Namespaces: {}
          Topic:
            Depth: 5
            Durability Policy: Volatile
            History Policy: Keep Last
            Reliability Policy: Reliable
            Value: /dune_point_markers
          Value: false
        - Class: rviz_default_plugins/MarkerArray
          Enabled: false
          Name: NRMP Points (toggle)
          Namespaces: {}
          Topic:
            Depth: 5
            Durability Policy: Volatile
            History Policy: Keep Last
            Reliability Policy: Reliable
            Value: /nrmp_point_markers
          Value: false
      Enabled: true
      Name: NeuPAN
  Enabled: true
  Global Options:
    Background Color: 35; 38; 43
    Fixed Frame: map
    Frame Rate: 30
  Name: NeuPAN Simulation
  Tools:
    - Class: rviz_default_plugins/Interact
      Hide Inactive Objects: true
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/FocusCamera
    - Class: rviz_default_plugins/Measure
      Line color: 128; 128; 0
  Transformation:
    Current:
      Class: rviz_default_plugins/TF
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 18
      Enable Stereo Rendering:
        Stereo Eye Separation: 0.06
        Stereo Focal Distance: 1
        Swap Stereo Eyes: false
        Value: false
      Focal Point:
        X: 6.5
        Y: 0
        Z: 0
      Focal Shape Fixed Size: false
      Focal Shape Size: 0.05
      Invert Z Axis: false
      Name: Current View
      Near Clip Distance: 0.01
      Pitch: 1.55
      Target Frame: <Fixed Frame>
      Yaw: 0
Window Geometry:
  Displays:
    collapsed: false
  Height: 900
  Hide Left Dock: false
  Hide Right Dock: true
  Width: 1440
  X: 60
  Y: 40
