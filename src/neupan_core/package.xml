<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>neupan_core</name>
  <version>0.1.0</version>
  <description>ROS-independent C++ NeuPAN planning library (DUNE, PAN, and NRMP).</description>
  <maintainer email="sales@hive-matrix.com">KevinLADLee (Hive Matrix Limited)</maintainer>
  <license>GPL-3.0-or-later</license>
  <url type="repository">https://github.com/hanruihua/NeuPAN</url>

  <buildtool_depend>cmake</buildtool_depend>
  <depend>neupan_solver_vendor</depend>
  <depend>eigen</depend>
  <depend>yaml-cpp</depend>

  <test_depend>gtest</test_depend>

  <export>
    <build_type>cmake</build_type>
  </export>
</package>
